# --- Core ---------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Leave empty to use a local SQLite file in backend/data/.
# For Postgres: postgresql://user:password@host:5432/hirescout
DATABASE_URL=

# --- AI (optional, but recommended) -------------------------------------
# Free key: https://aistudio.google.com/apikey
# Without it, HireScout falls back to rule-based parsing and skill matching.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Google Drive auto-import (optional) --------------------------------
# Path to a service-account JSON key; share the folder with its email.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=
